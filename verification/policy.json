  "platform_twins": [
    {
      "powershell": "bin/oracle.ps1",
      "posix": "bin/oracle",
      "reason": "The operator CLI keeps its historical extensionless POSIX entry point."
    },
    {
      "powershell": "bin/checkpoint.ps1",
      "posix": "bin/checkpoint",
      "reason": "The checkpoint command keeps its historical extensionless POSIX entry point."
    },
    {
      "powershell": "serving/serve-windows.ps1",
      "posix": "serving/service.sh",
      "reason": "Both scripts own the native service lifecycle for their operating system."
    }
  ],
  "platform_scoped": [
    {
      "path": "bin/envoy-discover",
      "platform": "posix",
      "reason": "Implements the POSIX envoy discovery client with shell utilities."
    },
    {
      "path": "bin/envoy-fetch",
      "platform": "posix",
      "reason": "Implements the POSIX fetch-only envoy boundary with shell utilities."
    },
    {
      "path": "bin/oracle-menu",
      "platform": "macos",
      "reason": "Provides the interactive terminal menu for the macOS appliance."
    },
    {
      "path": "install",
      "platform": "macos",
      "reason": "Runs the guided macOS arm64 offline installation flow."
    },
    {
      "path": "bootstrap/build-installers.ps1",
      "platform": "windows",
      "reason": "Builds both self-extracting release formats with Windows packaging tools."
    },
    {
      "path": "bootstrap/build-macos-package.sh",
      "platform": "macos",
      "reason": "Uses macOS pkgbuild to wrap the verified source installer in an unsigned package."
    },
    {
      "path": "bootstrap/envoy.sh",
      "platform": "posix",
      "reason": "Controls the POSIX firewall window and process trap for the envoy."
    },
    {
      "path": "bootstrap/finish-windows.ps1",
      "platform": "windows",
      "reason": "Completes Windows authoring-machine setup and local vault wiring."
    },
    {
      "path": "bootstrap/harden-offline.sh",
      "platform": "macos",
      "reason": "Maintains the macOS pf-based offline compatibility entry point."
    },
    {
      "path": "bootstrap/install.sh",
      "platform": "macos",
      "reason": "Installs policy-bound macOS arm64 cache artifacts without acquisition."
    },
    {
      "path": "bootstrap/render-config.sh",
      "platform": "posix",
      "reason": "Provides a POSIX compatibility entry point for the shared serving renderer."
    },
    {
      "path": "bootstrap/verify-offline.sh",
      "platform": "posix",
      "reason": "Provides a POSIX compatibility entry point for shared read-only serving probes."
    },
    {
      "path": "connectors/gitea/setup-gitea.sh",
      "platform": "macos",
      "reason": "Installs the optional Gitea vault UI through Homebrew and launchd."
    },
    {
      "path": "connectors/ide/brand.ps1",
      "platform": "windows",
      "reason": "Patches the Windows VSCodium installation resources."
