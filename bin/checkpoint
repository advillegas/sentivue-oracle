#!/usr/bin/env bash
# checkpoint "message" — the ratchet in one command: commit everything + ledger entry.
# Used by agents mid-task so progress is crash-safe and the ledger stays current.
# Guard: refuses to commit huge binaries (the class of incident that once pushed
# ~1 GB of toolchain into history and needed a rewrite + force-push to undo).
set -euo pipefail
msg="${1:?usage: checkpoint \"message\"}"
git add -A

# large-file guard: nothing 50 MB or larger gets committed by an agent
big=""
while IFS= read -r f; do
  [[ -f "$f" ]] || continue
  sz=$(wc -c < "$f" | xargs)
  if [[ "$sz" -ge $((50 * 1024 * 1024)) ]]; then big="$big  $f ($((sz / 1024 / 1024)) MB)\n"; fi
done < <(git diff --cached --name-only --diff-filter=AM)
if [[ -n "$big" ]]; then
  printf 'checkpoint: REFUSED — staged files 50 MB or larger:\n%b' "$big"
  echo "checkpoint: unstage them (git restore --staged <file>) and add to .gitignore; artifacts belong in artifacts/ or models/"
  exit 1
fi

if git diff --cached --quiet; then
  echo "checkpoint: nothing to commit"
else
  git commit -q -m "$msg"
fi
root="${ORACLE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
mkdir -p "$root/memory"
echo "- **$(date '+%Y-%m-%d %H:%M:%S')** [checkpoint:$(basename "$PWD")] $msg ($(git rev-parse --short HEAD))" >> "$root/memory/LEDGER.md"
echo "checkpoint: $msg ($(git rev-parse --short HEAD))"
