#!/usr/bin/env bash
# oracle — single entry point for the SentiVue Oracle appliance.
set -euo pipefail
SELF="${BASH_SOURCE[0]}"
[[ -L "$SELF" ]] && SELF="$(readlink -f "$SELF")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
cd "$ROOT"
export PATH="$ROOT/env/.venv/bin:$ROOT/.tools/bin:$ROOT/.tools/npm/bin:$PATH"
export ORACLE_ROOT="$ROOT"
export ORACLE_PROJECT_ROOT="$ROOT"
# shellcheck source=/dev/null
source "$ROOT/engines/shared/lean-ctx-env.sh"
export UV_OFFLINE=1
export UV_CACHE_DIR="$ROOT/incoming/dependency-cache/uv"

cmd="${1:-help}"; shift || true
case "$cmd" in
  claude)     exec bash engines/claude-code/launch.sh "$@" ;;
  opencode)   exec bash engines/opencode/launch.sh "$@" ;;
  kilo)       exec bash engines/kilo/launch.sh "$@" ;;
  context|ctx)
    sub="${1:-status}"; shift || true
    allowed=false
    case "$sub" in
      status|doctor|version|help|--version|--help)
        [[ "$#" -eq 0 ]] && allowed=true
        ;;
      gain)
        [[ "$#" -eq 0 || ( "$#" -eq 1 && "$1" == "--json" ) ]] && allowed=true
        ;;
      benchmark)
        [[ "$#" -eq 0 || ( "$#" -eq 2 && "$1" == "run" && "$2" == "." ) ]] \
          && allowed=true
        ;;
    esac
    [[ "$allowed" == true ]] || {
      echo "ERROR: oracle ctx exposes read-only local diagnostics only." >&2
      exit 2
    }
    [[ -x "$ROOT/.tools/bin/lean-ctx" ]] || {
      echo "ERROR: policy-bound lean-ctx is missing; run ./install." >&2
      exit 1
    }
    exec "$ROOT/.tools/bin/lean-ctx" "$sub" "$@"
    ;;
  serve)      exec bash serving/service.sh start ;;
  stop)       exec bash serving/service.sh stop ;;
  restart)    exec bash serving/service.sh restart ;;
  status)     exec bash serving/service.sh status ;;
  service)    exec bash serving/service.sh "$@" ;;
  capabilities) exec bash serving/service.sh capabilities "$@" ;;
  verify)     exec bash serving/service.sh verify "$@" ;;
  doctor)     exec bash bootstrap/doctor.sh ;;
  harden)     [[ "${1:-on}" == "off" ]] && exec sudo bash bootstrap/harden-egress.sh off \
                                        || exec sudo bash bootstrap/harden-egress.sh on ;;
  egress)     exec bash bootstrap/harden-egress.sh "${1:-status}" ;;
  audit)      exec bash bootstrap/security-audit.sh "$@" ;;
  verify-egress) exec bash bootstrap/verify-egress.sh ;;
  models)     exec bash bootstrap/download-models.sh ;;
  skills)     exec bash bootstrap/sync-skills.sh ;;
  vault)
    if [[ "${1:-}" == "ui" ]]; then exec bash connectors/gitea/setup-gitea.sh "${2:-status}"; fi
    exec bash bootstrap/vault.sh "$@" ;;
  envoy)      exec bash bootstrap/envoy.sh "$@" ;;
  console)    exec "$ROOT/env/.venv/bin/python" conductor/console.py ;;
  ide)        exec bash connectors/ide/setup-ide.sh "${1:-launch}" ;;
  notes)      # Obsidian over a repository (default: this repo). Decision 0002:
              # the operator's per-repository lens on code + memory/doctrine.
    target="${1:-$ROOT}"
    case "$target" in /*) ;; *) target="$ROOT/$target" ;; esac
    if [[ ! -d "/Applications/Obsidian.app" && ! -d "$HOME/Applications/Obsidian.app" ]]; then
      echo "ERROR: Obsidian is optional and not installed - get it from" >&2
      echo "       https://obsidian.md (or your package manager), then rerun." >&2
      exit 1
    fi
    open "obsidian://open?path=$(python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))' "$target" 2>/dev/null || echo "$target")" \
      || open -a Obsidian "$target"
    ;;
  agents-ui)  # Agent-MCP orchestration viewer (optional): watch agents/tasks/context live
    sub="${1:-start}"
    bash harness/agent-mcp/setup-agent-mcp.sh "$sub"
    [[ "$sub" == "start" ]] && { sleep 3; open "http://127.0.0.1:3847" 2>/dev/null || true; }
    ;;
  loops)      # loop-engineering CLIs (pinned in .tools/npm): audit|init|cost|sync
    export PATH="$ROOT/.tools/npm/bin:$PATH"
    sub="${1:-audit}"; shift || true
    case "$sub" in
      audit) exec loop-audit "$ROOT" "$@" ;;
      init)  exec loop-init "$ROOT" "$@" ;;
      cost)  exec loop-cost "$@" ;;
      sync)  exec loop-sync "$ROOT" "$@" ;;
      *) echo "usage: oracle loops {audit|init|cost|sync} [args]"; exit 1 ;;
    esac
    ;;
  mission)    # oracle mission <mission.toml> [claude|opencode|kilo] [hours]
    m="${1:?usage: oracle mission <mission.toml> [engine] [hours]}"
    eng="${2:-claude}"; hrs="${3:-24}"
    exec "$ROOT/env/.venv/bin/python" conductor/conductor.py run "$m" --engine "$eng" --hours "$hrs" ;;
  retro)      exec "$ROOT/env/.venv/bin/python" conductor/conductor.py retro --engine "${1:-claude}" ;;
  state)      "$ROOT/env/.venv/bin/python" conductor/conductor.py status ;;
  report)     ls -1t reports/ 2>/dev/null | head -5 || echo "no reports yet" ;;
  ledger)     tail -n "${1:-20}" memory/LEDGER.md 2>/dev/null || echo "no ledger yet" ;;
  uninstall)  exec bash bootstrap/uninstall.sh "$@" ;;
  help|*)
    cat <<'EOF'
oracle — offline agentic workstation

  engines        oracle claude [...]     oracle opencode [...]     oracle kilo [...]
  context        oracle ctx [status|gain|doctor|benchmark ...]
  serving        oracle serve|stop|restart|status
                 oracle service install|uninstall|start|stop|restart|status
                 oracle capabilities     inferred vs loaded backend/context evidence
  missions       oracle mission <toml> [claude|opencode|kilo] [hours]
                 oracle retro [engine]   process meta-analysis + amendment proposals
                 oracle state            oracle report        oracle ledger [n]
  health         oracle verify           oracle doctor
  privacy        oracle harden [off]     default-deny egress (all agent/editor/inference procs)
                 oracle egress [status|plan]              inspect the egress guard
                 oracle verify-egress    prove no leaks + loopback intact
                 oracle audit [--deep]   full platform security sweep
                 oracle envoy [--queue]  controlled fetch-only network window
  ui             oracle ide [install]    VSCodium + local-only engine extensions
                 oracle console          mission control at http://127.0.0.1:8800
                 oracle agents-ui [install|stop|status]  orchestration viewer (Agent-MCP) at http://127.0.0.1:3847
                 oracle notes [path]     Obsidian over a repository (default: this repo)
                 oracle vault ui install|start|stop|status        GitHub-like UI at http://127.0.0.1:3300
  loops          oracle loops audit|init|cost|sync                loop-engineering toolkit
  git vault      oracle vault init|sync|new|clone|list|backup     (offline private remote)
  maintenance    oracle models           oracle skills        oracle uninstall [--apply]
                 purge: oracle uninstall --apply --purge --confirm-purge
EOF
    ;;
esac
