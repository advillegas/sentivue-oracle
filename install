#!/usr/bin/env bash
# ============================================================================
#  SentiVue Oracle — guided installer for the Mac Studio
#
#    ./install                    interactive
#    ./install --yes              non-interactive (full ensemble)
#    ./install --profile coder    full|coder|minimal
#    ./install --no-models        everything except model downloads
#
#  Phases are idempotent and checkpointed in .install-state — if anything
#  fails (or you lose the network mid-download), just re-run ./install and
#  it resumes where it stopped.
# ============================================================================
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
STATE=".install-state"
YES=0; PROFILE=""; NO_MODELS=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes) YES=1 ;;
    --profile) PROFILE="$2"; shift ;;
    --no-models) NO_MODELS=1 ;;
    *) echo "unknown flag: $1"; exit 1 ;;
  esac; shift
done

say()  { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m ✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m ! %s\033[0m\n' "$*"; }
die()  { printf '\033[1;31m ✗ %s\033[0m\n' "$*"; exit 1; }

phase_done() { grep -qx "done=$1" "$STATE" 2>/dev/null; }
mark_done()  { echo "done=$1" >> "$STATE"; }

# ---------------------------------------------------------------- preflight
if ! phase_done preflight; then
  say "Preflight"
  [[ "$(uname -s)/$(uname -m)" == "Darwin/arm64" ]] \
    || die "This installer targets macOS on Apple Silicon (Mac Studio)."
  command -v brew >/dev/null \
    || die 'Homebrew missing. Install it first: /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
  xcode-select -p >/dev/null 2>&1 || { warn "Installing Xcode Command Line Tools…"; xcode-select --install || true; }
  ram_gb=$(( $(sysctl -n hw.memsize) / 1073741824 ))
  ok "macOS arm64, ${ram_gb} GB unified memory, Homebrew present"
  [[ $ram_gb -lt 500 ]] && warn "Less than 512 GB RAM — pick the 'coder' or 'minimal' profile."
  mark_done preflight
fi

# ---------------------------------------------------------------- bootstrap
if ! phase_done bootstrap; then
  say "Bootstrap (brew packages, pinned engines, python env, skills, ECC)"
  bash bootstrap/install.sh
  mark_done bootstrap
else ok "bootstrap already done"; fi

# ---------------------------------------------------------------- profile
if ! phase_done profile; then
  say "Model profile"
  if [[ -z "$PROFILE" ]]; then
    if [[ $YES -eq 1 ]]; then PROFILE=full; else
      cat <<'EOF'
  1) full     ~700 GB  Qwen3-Coder-480B + Kimi-K2-Thinking + DeepSeek-V3.2 + fast lane   (the design target)
  2) coder    ~315 GB  Qwen3-Coder-480B + fast lane                    (no opus-class reasoner)
  3) minimal   ~40 GB  fast lane only                                  (smoke-test the plumbing first)
EOF
      read -rp "  choose [1/2/3, default 1]: " ans
      case "${ans:-1}" in 2) PROFILE=coder ;; 3) PROFILE=minimal ;; *) PROFILE=full ;; esac
    fi
  fi
  case "$PROFILE" in
    full)
      rm -f serving/models.profile
      OPUS=kimi-k2-thinking; SONNET=qwen3-coder-480b; HAIKU=qwen3-coder-30b ;;
    coder)
      printf '%s\n' qwen3-coder-480b qwen3-coder-30b qwen3-embedding-4b > serving/models.profile
      OPUS=qwen3-coder-480b; SONNET=qwen3-coder-480b; HAIKU=qwen3-coder-30b ;;
    minimal)
      printf '%s\n' qwen3-coder-30b qwen3-embedding-4b > serving/models.profile
      OPUS=qwen3-coder-30b; SONNET=qwen3-coder-30b; HAIKU=qwen3-coder-30b ;;
    *) die "unknown profile '$PROFILE' (full|coder|minimal)" ;;
  esac
  printf 'OPUS_MODEL=%s\nSONNET_MODEL=%s\nHAIKU_MODEL=%s\n' "$OPUS" "$SONNET" "$HAIKU" > serving/tiers.env

  # Point every tier reference at models that actually exist in this profile.
  S=engines/claude-code/home/settings.json
  jq --arg o "$OPUS" --arg s "$SONNET" --arg h "$HAIKU" '
     .env.ANTHROPIC_DEFAULT_OPUS_MODEL=$o | .env.ANTHROPIC_DEFAULT_SONNET_MODEL=$s |
     .env.ANTHROPIC_DEFAULT_HAIKU_MODEL=$h | .env.ANTHROPIC_MODEL=$s |
     .env.ANTHROPIC_SMALL_FAST_MODEL=$h  | .model=$s' "$S" > "$S.tmp" && mv "$S.tmp" "$S"
  O=engines/opencode/xdg/opencode/opencode.json
  jq --arg s "oracle/$SONNET" --arg h "oracle/$HAIKU" \
     '.model=$s | .small_model=$h' "$O" > "$O.tmp" && mv "$O.tmp" "$O"
  sed -i '' "s|^model: oracle/.*|model: oracle/$OPUS|" engines/opencode/xdg/opencode/agent/adversary.md
  ok "profile: $PROFILE (opus→$OPUS, sonnet→$SONNET, haiku→$HAIKU)"
  mark_done profile
else ok "profile already chosen ($(cat serving/tiers.env 2>/dev/null | tr '\n' ' '))"; fi

# ---------------------------------------------------------------- models
if [[ $NO_MODELS -eq 0 ]] && ! phase_done models; then
  say "Model downloads (resumable — re-run ./install if interrupted)"
  free_gb=$(df -g . | awk 'NR==2 {print $4}')
  case "$(head -1 serving/tiers.env)" in
    OPUS_MODEL=kimi*) need=800 ;;
    OPUS_MODEL=qwen3-coder-480b) need=400 ;;
    *) need=60 ;;
  esac
  [[ $free_gb -lt $need ]] && die "Only ${free_gb} GB free; this profile needs ~${need} GB. Free space and re-run."
  bash bootstrap/download-models.sh
  mark_done models
elif [[ $NO_MODELS -eq 1 ]]; then warn "skipping model downloads (--no-models)"
else ok "models already downloaded"; fi

# ---------------------------------------------------------------- serve+verify
if [[ $NO_MODELS -eq 0 ]]; then
  say "Render config + start serving"
  bash bootstrap/render-config.sh
  bash serving/service.sh start
  say "Waiting for llama-swap health…"
  for _ in $(seq 1 30); do
    curl -sf -m 2 http://127.0.0.1:9099/health >/dev/null 2>&1 && break; sleep 2
  done
  say "Offline verification"
  bash bootstrap/verify-offline.sh || warn "verify reported failures — run 'oracle doctor' for diagnosis"
fi

# ---------------------------------------------------------------- desktop shortcut
if [[ -d "$HOME/Desktop" ]]; then
  cat > "$HOME/Desktop/SentiVue Oracle.command" <<EOF
#!/bin/bash
exec bash "$ROOT/bin/oracle-menu"
EOF
  chmod +x "$HOME/Desktop/SentiVue Oracle.command"
  ok "desktop shortcut created: SentiVue Oracle"
fi

# ---------------------------------------------------------------- done
say "Install complete"
cat <<EOF

  Daily driving:
    oracle claude          interactive session, Claude Code engine
    oracle opencode        interactive session, OpenCode engine
    oracle status          service + model + memory status
    oracle doctor          full diagnostic with suggested fixes
    oracle mission conductor/missions/example.toml claude 24

  Privacy:
    telemetry/autoupdate are OFF for both engines; everything binds 127.0.0.1.
    To enforce a software air gap:   oracle harden      (undo: oracle harden off)

  Re-run ./install any time — completed phases are skipped.
EOF
