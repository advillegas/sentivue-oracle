#!/usr/bin/env bash
# ============================================================================
#  SentiVue Oracle — guided installer for the Mac Studio
#
#    ./install                    interactive
#    ./install --yes              non-interactive (full ensemble)
#    ./install --profile coder    full|coder|minimal
#    ./install --no-models        everything except model downloads
#
#  Phases are idempotent and checkpointed in .install-state — if anything
#  fails, just re-run ./install and
#  it resumes where it stopped.
# ============================================================================
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
DEPENDENCY_CACHE="${ORACLE_DEPENDENCY_CACHE:-$ROOT/incoming/dependency-cache}"
YES=0; PROFILE=""; NO_MODELS=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes) YES=1 ;;
    --profile) PROFILE="$2"; shift ;;
    --no-models) NO_MODELS=1 ;;
    *) echo "unknown flag: $1"; exit 1 ;;
  esac; shift
done

say()  { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m ✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m ! %s\033[0m\n' "$*"; }
die()  { printf '\033[1;31m ✗ %s\033[0m\n' "$*"; exit 1; }

PYTHON_BIN=""
STATE_READY=0
find_python() {
  local candidate
  for candidate in "$ROOT/env/.venv/bin/python" python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 12))' >/dev/null 2>&1; then
      PYTHON_BIN="$candidate"
      return 0
    fi
  done
  return 1
}
init_state() {
  [[ -n "$PYTHON_BIN" ]] || find_python || return 1
  "$PYTHON_BIN" "$ROOT/verification/lifecycle.py" state init \
    --root "$ROOT" --home "$HOME" >/dev/null
  STATE_READY=1
}
phase_done() {
  [[ "$STATE_READY" -eq 1 ]] || return 1
  if "$PYTHON_BIN" "$ROOT/verification/lifecycle.py" state phase-current \
      --root "$ROOT" --home "$HOME" --phase "$1" >/dev/null; then
    return 0
  fi
  "$PYTHON_BIN" "$ROOT/verification/lifecycle.py" state begin-phase \
    --root "$ROOT" --home "$HOME" --phase "$1" >/dev/null
  return 1
}
mark_done() {
  [[ "$STATE_READY" -eq 1 ]] || return 0
  "$PYTHON_BIN" "$ROOT/verification/lifecycle.py" state mark-phase \
    --root "$ROOT" --home "$HOME" --phase "$1"
}
own_path() {
  [[ "$STATE_READY" -eq 1 ]] || die "install state is unavailable while registering $1"
  [[ -e "$1" || -L "$1" ]] || die "cannot register missing owned path: $1"
  "$PYTHON_BIN" "$ROOT/verification/lifecycle.py" state own \
    --root "$ROOT" --home "$HOME" --path "$1"
}
own_tree() {
  [[ "$STATE_READY" -eq 1 ]] || die "install state is unavailable while registering $1"
  [[ -d "$1" ]] || die "cannot register missing owned tree: $1"
  "$PYTHON_BIN" "$ROOT/verification/lifecycle.py" state own-tree \
    --root "$ROOT" --home "$HOME" --path "$1"
}
own_service() {
  [[ "$STATE_READY" -eq 1 ]] || die "install state is unavailable while registering service $2"
  "$PYTHON_BIN" "$ROOT/verification/lifecycle.py" state own-service \
    --root "$ROOT" --home "$HOME" \
    --service-kind "$1" --identifier "$2"
}
atomic_from_stdin() {
  local target="$1" temporary
  mkdir -p "$(dirname "$target")"
  temporary="$(mktemp "${target}.tmp.XXXXXX")"
  if ! cat > "$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  if ! mv -f "$temporary" "$target"; then
    rm -f "$temporary"
    return 1
  fi
}

init_state || die "Pinned Python is required before offline installation can begin."

# ---------------------------------------------------------------- preflight
if ! phase_done preflight; then
  say "Preflight"
  [[ "$(uname -s)/$(uname -m)" == "Darwin/arm64" ]] \
    || die "This installer targets macOS on Apple Silicon (Mac Studio)."
  xcode-select -p >/dev/null 2>&1 \
    || die "Xcode Command Line Tools are a platform prerequisite; provision them before offline install."
  ram_gb=$(( $(sysctl -n hw.memsize) / 1073741824 ))
  ok "macOS arm64, ${ram_gb} GB unified memory"
  [[ $ram_gb -lt 500 ]] && warn "Less than 512 GB RAM — pick the 'coder' or 'minimal' profile."
  mark_done preflight
fi

# ---------------------------------------------------------------- bootstrap
if ! phase_done bootstrap; then
  say "Bootstrap (policy-bound tools, pinned engines, python env, skills, ECC)"
  bash bootstrap/install.sh
  init_state || die "Python 3.12 is unavailable after bootstrap; install state cannot be recorded."
  mark_done bootstrap
else ok "bootstrap already done"; fi

# ---------------------------------------------------------------- profile
if ! phase_done profile; then
  say "Model profile (hardware-adaptive)"
  mem_gb=$(( $(sysctl -n hw.memsize) / 1073741824 ))
  budget=$(( mem_gb * 85 / 100 ))     # leave headroom for the OS
  SUGGEST="micro"
  while IFS='|' read -r name min models o s h dl; do
    name="$(echo "$name" | xargs)"; min="$(echo "$min" | xargs)"
    [[ -z "$name" || "$name" == \#* ]] && continue
    [[ $budget -ge $min ]] && { SUGGEST="$name"; break; }
  done < <(grep -Ev '^\s*#' serving/profiles.conf)
  if [[ -z "$PROFILE" ]]; then
    if [[ $YES -eq 1 ]]; then PROFILE="$SUGGEST"; else
      echo "  detected ${mem_gb} GB unified memory — suggested profile: $SUGGEST"
      echo
      grep -Ev '^\s*#' serving/profiles.conf | while IFS='|' read -r name min models o s h dl; do
        printf "    %-6s needs >= %3s GB   download %s\n" "$(echo "$name"|xargs)" "$(echo "$min"|xargs)" "$(echo "$dl"|xargs)"
      done
      echo
      read -rp "  profile [ENTER = $SUGGEST]: " ans
      PROFILE="${ans:-$SUGGEST}"
    fi
  fi
  LINE="$(grep -Ev '^\s*#' serving/profiles.conf | awk -F'|' -v p="$PROFILE" '$1 ~ p"[ ]*$" || $1 == p {print; exit}')"
  [[ -n "$LINE" ]] || LINE="$(grep -Ev '^\s*#' serving/profiles.conf | grep -E "^${PROFILE}[[:space:]]*\|" | head -1)"
  [[ -n "$LINE" ]] || die "unknown profile '$PROFILE' (see serving/profiles.conf)"
  MODELS="$(echo "$LINE" | cut -d'|' -f3 | xargs)"
  OPUS="$(echo "$LINE" | cut -d'|' -f4 | xargs)"
  SONNET="$(echo "$LINE" | cut -d'|' -f5 | xargs)"
  HAIKU="$(echo "$LINE" | cut -d'|' -f6 | xargs)"
  if [[ "$PROFILE" == "full" ]]; then
    rm -f serving/models.profile
  else
    echo "$MODELS" | tr ',' '\n' | atomic_from_stdin "$ROOT/serving/models.profile"
    own_path "$ROOT/serving/models.profile"
  fi
  printf 'OPUS_MODEL=%s\nSONNET_MODEL=%s\nHAIKU_MODEL=%s\n' \
    "$OPUS" "$SONNET" "$HAIKU" | atomic_from_stdin "$ROOT/serving/tiers.env"
  own_path "$ROOT/serving/tiers.env"

  # Tracked templates stay immutable. Runtime engine and IDE configurations are
  # generated atomically after model files are available.
  ok "profile: $PROFILE (opus→$OPUS, sonnet→$SONNET, haiku→$HAIKU)"
  mark_done profile
else ok "profile already chosen ($(cat serving/tiers.env 2>/dev/null | tr '\n' ' '))"; fi

# ---------------------------------------------------------------- models
if [[ $NO_MODELS -eq 0 ]] && ! phase_done models; then
  say "Validate policy-bound local model snapshot"
  free_gb=$(df -g . | awk 'NR==2 {print $4}')
  case "$(head -1 serving/tiers.env)" in
    OPUS_MODEL=kimi*) need=800 ;;
    OPUS_MODEL=qwen3-coder-480b) need=400 ;;
    OPUS_MODEL=qwen3-coder-30b) need=60 ;;
    *) need=35 ;;
  esac
  [[ $free_gb -lt $need ]] && die "Only ${free_gb} GB free; this profile needs ~${need} GB. Free space and re-run."
  IFS=',' read -r -a selected_models <<< "$MODELS"
  for model_name in "${selected_models[@]}"; do
    model_name="$(echo "$model_name" | xargs)"
    revision="$(awk -F'|' -v name="$model_name" \
      '$1 ~ "^[[:space:]]*" name "[[:space:]]*$" {gsub(/[[:space:]]/, "", $7); print $7; exit}' \
      serving/models.manifest)"
    [[ "$revision" =~ ^[0-9a-f]{40}$ ]] ||
      die "Model $model_name has no promoted immutable revision."
    "$PYTHON_BIN" "$ROOT/verification/lifecycle.py" artifact-path \
      --manifest "$DEPENDENCY_CACHE/manifest.json" --cache "$DEPENDENCY_CACHE" \
      --artifact-id "model:$model_name" --expected-version "$revision" \
      --expected-requested-version "$revision" --root "$ROOT" --reproducible \
      >/dev/null ||
      die "Model $model_name is not a trusted offline snapshot."
  done
  init_state || die "Could not refresh install state after model validation."
  own_tree "$ROOT/models"
  mark_done models
elif [[ $NO_MODELS -eq 1 ]]; then warn "skipping model downloads (--no-models)"
else ok "models already downloaded"; fi

# ---------------------------------------------------------------- serve+verify
if [[ $NO_MODELS -eq 0 ]]; then
  say "Render config + start serving"
  bash connectors/ide/sync-models.sh
  own_tree "$ROOT/state/generated"
  bash bootstrap/render-config.sh
  own_path "$ROOT/serving/llama-swap.rendered.yaml"
  bash serving/service.sh start
  own_path "$HOME/Library/LaunchAgents/com.sentivue.llamaswap.plist"
  own_service launchd-user com.sentivue.llamaswap
  own_path "$ROOT/logs"
  say "Waiting for llama-swap health…"
  healthy=0
  for _ in $(seq 1 30); do
    if curl -sf -m 2 http://127.0.0.1:9099/health >/dev/null 2>&1; then
      healthy=1
      break
    fi
    sleep 2
  done
  [[ "$healthy" -eq 1 ]] || die "llama-swap did not become healthy"
  say "Offline verification"
  bash bootstrap/verify-offline.sh
fi

# ---------------------------------------------------------------- desktop shortcut
if [[ -d "$HOME/Desktop" ]]; then
  atomic_from_stdin "$HOME/Desktop/SentiVue Oracle.command" <<EOF
#!/bin/bash
exec bash "$ROOT/bin/oracle-menu"
EOF
  chmod +x "$HOME/Desktop/SentiVue Oracle.command"
  own_path "$HOME/Desktop/SentiVue Oracle.command"
  ok "desktop shortcut created: SentiVue Oracle"
fi

# ---------------------------------------------------------------- done
say "Install complete"
cat <<EOF

  Daily driving:
    oracle claude          interactive session, Claude Code engine
    oracle opencode        interactive session, OpenCode engine
    oracle status          service + model + memory status
    oracle doctor          full diagnostic with suggested fixes
    oracle mission conductor/missions/example.toml claude 24

  Privacy:
    telemetry/autoupdate are OFF for both engines; everything binds 127.0.0.1.
    To enforce a software air gap:   oracle harden      (undo: oracle harden off)

  Re-run ./install any time — completed phases are skipped.
EOF
