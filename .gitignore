# runtime state (plain-text memory lives here at runtime; templates are in conductor/templates)
memory/*
!memory/.gitkeep
reports/
state/
logs/
.worktrees/

# models and market data are huge and machine-local
models/
data/*
!data/.gitkeep
artifacts/
backups/
incoming/

# rendered / machine-specific configs and installer state
serving/llama-swap.rendered.yaml
serving/llama-swap.rendered.win.yaml
serving/model-paths.env
serving/models.profile
serving/tiers.env
.install-state

# python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# node
node_modules/

# machine-local toolchains (engines, llama binaries) — installed, never committed
.tools/

# engine RUNTIME state (config templates stay tracked: settings.json, CLAUDE.md, agents/)
engines/claude-code/home/plugins/
engines/claude-code/home/projects/
engines/claude-code/home/sessions/
engines/claude-code/home/backups/
engines/claude-code/home/todos/
engines/claude-code/home/statsig/
engines/claude-code/home/shell-snapshots/
engines/claude-code/home/history.jsonl
engines/claude-code/home/.claude.json*
engines/claude-code/home/.last-cleanup
engines/claude-code/home/skills/
engines/opencode/xdg/opencode/skill/

# secrets / local env — never commit credentials or private keys
.env
.env.*
!.env.example
connectors/supabase/.env
**/credentials*.json
*.key
*.pem
id_rsa
id_ed25519
*.p12
*.pfx

# supabase volumes
connectors/supabase/volumes/

# macOS
.DS_Store

# vendored harness checkouts (installed, not committed)
harness/*/vendor/

# Agent-MCP runtime state (sqlite + tokens; machine-local)
.agent/

# Obsidian vault state is machine-local except the shared config (decision 0002)
.obsidian/*
!.obsidian/app.json

# per-worktree task scaffolding must never land on main (A11 leak guard)
/TASKPLAN.md
/RESEARCH.md
/FEEDBACK.md
