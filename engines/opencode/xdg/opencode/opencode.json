{
    "$schema":  "https://opencode.ai/config.json",
    "autoupdate":  false,
    "share":  "disabled",
    "instructions":  [
                         "{env:ORACLE_ROOT}/engines/shared/CONVENTIONS.md",
                         "{env:ORACLE_ROOT}/engines/shared/AUTONOMY.md"
                     ],
    "provider":  {
                     "oracle":  {
                                    "npm":  "@ai-sdk/openai-compatible",
                                    "name":  "Oracle (local llama-swap)",
                                    "options":  {
                                                    "baseURL":  "http://127.0.0.1:9099/v1",
                                                    "apiKey":  "oracle-local"
                                                },
                                    "models":  {
                                                   "qwen2.5-coder-7b":  {
                                                                            "name":  "qwen2.5-coder-7b (local)",
                                                                            "tool_call":  true,
                                                                            "limit":  {
                                                                                          "context":  16384,
                                                                                          "output":  8192
                                                                                      }
                                                                        }
                                               }
                                }
                 },
    "mcp":  {
                "duckdb":  {
                               "type":  "local",
                               "command":  [
                                               "uvx",
                                               "--from",
                                               "mcp-server-duckdb==1.1.0",
                                               "mcp-server-duckdb",
                                               "--db-path",
                                               "{env:ORACLE_ROOT}/data/lake.duckdb"
                                           ],
                               "enabled":  true
                           },
                "postgres":  {
                                 "type":  "local",
                                 "command":  [
                                                 "uvx",
                                                 "--from",
                                                 "postgres-mcp==0.3.0",
                                                 "postgres-mcp",
                                                 "--access-mode",
                                                 "restricted"
                                             ],
                                 "environment":  {
                                                     "DATABASE_URI":  "postgresql://postgres:{env:ORACLE_PG_PASSWORD}@127.0.0.1:54322/postgres"
                                                 },
                                 "enabled":  false
                             }
            },
    "permission":  {
                       "edit":  "allow",
                       "bash":  {
                                    "*":  "ask",
                                    "uv run *":  "allow",
                                    "git status*":  "allow",
                                    "git diff*":  "allow",
                                    "git log*":  "allow",
                                    "git add *":  "allow",
                                    "git commit *":  "allow",
                                    "cargo build*":  "allow",
                                    "cargo test*":  "allow",
                                    "cargo clippy*":  "allow",
                                    "pytest*":  "allow",
                                    "cmake*":  "allow",
                                    "make test*":  "allow",
                                    "curl *":  "deny",
                                    "wget *":  "deny"
                                },
                       "webfetch":  "deny"
                   },
    "model":  "oracle/qwen2.5-coder-7b",
    "small_model":  "oracle/qwen2.5-coder-7b"
}
