{
    "$schema":  "https://opencode.ai/config.json",
    "autoupdate":  false,
    "share":  "disabled",
    "instructions":  [
                         "{env:ORACLE_ROOT}/engines/shared/CONVENTIONS.md",
                         "{env:ORACLE_ROOT}/engines/shared/AUTONOMY.md"
                     ],
    "provider":  {
                     "oracle":  {
                                    "npm":  "@ai-sdk/openai-compatible",
                                    "name":  "Oracle (local llama-swap)",
                                    "options":  {
                                                    "baseURL":  "http://127.0.0.1:9099/v1",
                                                    "apiKey":  "oracle-local"
                                                },
                                    "models":  {
                                                   "qwen2.5-coder-7b":  {
                                                                            "name":  "qwen2.5-coder-7b (local)",
                                                                            "tool_call":  true,
                                                                            "limit":  {
                                                                                          "context":  16384,
                                                                                          "output":  8192
                                                                                      }
                                                                        },
                                                   "qwen3-coder-30b-q4":  {
                                                                              "name":  "qwen3-coder-30b-q4 (local)",
                                                                              "tool_call":  true,
                                                                              "limit":  {
                                                                                            "context":  65536,
                                                                                            "output":  32768
                                                                                        }
                                                                          }
                                               }
                                }
                 },
    "mcp":  {
                "duckdb":  {
                               "type":  "local",
                               "command":  [
                                               "uvx",
                                               "--from",
                                               "mcp-server-duckdb==1.1.0",
                                               "mcp-server-duckdb",
                                               "--db-path",
                                               "{env:ORACLE_ROOT}/data/lake.duckdb"
                                           ],
                               "enabled":  true
                           },
                "postgres":  {
                                 "type":  "local",
                                 "command":  [
                                                 "uvx",
                                                 "--from",
                                                 "postgres-mcp==0.3.0",
                                                 "postgres-mcp",
                                                 "--access-mode",
                                                 "restricted"
                                             ],
                                 "environment":  {
                                                     "DATABASE_URI":  "postgresql://postgres:{env:ORACLE_PG_PASSWORD}@127.0.0.1:54322/postgres"
                                                 },
                                 "enabled":  false
                             },
                "agent-mcp":  {
                                  "type":  "remote",
                                  "url":  "http://127.0.0.1:8100/mcp",
                                  "enabled":  false
                              },
                "lean-ctx":  {
                                 "type":  "local",
                                 "command":  [
                                                 "python",
                                                 "{env:ORACLE_ROOT}/connectors/lean_ctx_mcp.py"
                                             ],
                                 "environment":  {
                                                     "LEAN_CTX_CONFIG_DIR":  "{env:ORACLE_ROOT}/state/lean-ctx/config",
                                                     "LEAN_CTX_DATA_DIR":  "{env:ORACLE_ROOT}/state/lean-ctx/data",
                                                     "LEAN_CTX_STATE_DIR":  "{env:ORACLE_ROOT}/state/lean-ctx/state",
                                                     "LEAN_CTX_CACHE_DIR":  "{env:ORACLE_ROOT}/state/lean-ctx/cache",
                                                     "LEAN_CTX_PROJECT_ROOT":  "{env:ORACLE_PROJECT_ROOT}",
                                                     "LEAN_CTX_TOOL_PROFILE":  "minimal",
                                                     "LEAN_CTX_DISABLED_TOOLS":  "ctx_call",
                                                     "LEAN_CTX_NO_UPDATE_CHECK":  "1",
                                                     "LEAN_CTX_AUTONOMY":  "false",
                                                     "LEAN_CTX_NO_HOOK":  "1",
                                                     "LEAN_CTX_RULES_INJECTION":  "off"
                                                 },
                                 "enabled":  true
                              }
            },
    "permission":  {
                       "edit":  "allow",
                       "bash":  {
                                    "*":  "ask",
                                    "uv run *":  "allow",
                                    "uv add *":  "allow",
                                    "pip install *":  "allow",
                                    "python -m pip install *":  "allow",
                                    "npm install *":  "allow",
                                    "winget install *":  "allow",
                                    "brew install *":  "allow",
                                    "cargo add *":  "allow",
                                    "git status*":  "allow",
                                    "git diff*":  "allow",
                                    "git log*":  "allow",
                                    "git add *":  "allow",
                                    "git commit *":  "allow",
                                    "cargo build*":  "allow",
                                    "cargo test*":  "allow",
                                    "cargo clippy*":  "allow",
                                    "pytest*":  "allow",
                                    "cmake*":  "allow",
                                    "make test*":  "allow",
                                    "curl *":  "deny",
                                    "wget *":  "deny"
                                },
                       "webfetch":  "deny"
                   },
    "model":  "oracle/qwen3-coder-30b-q4",
    "small_model":  "oracle/qwen3-coder-30b-q4"
}
