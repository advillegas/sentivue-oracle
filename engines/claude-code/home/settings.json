{
    "env":  {
                "ANTHROPIC_BASE_URL":  "http://127.0.0.1:9099",
                "ANTHROPIC_AUTH_TOKEN":  "oracle-local",
                "API_TIMEOUT_MS":  "1800000",
                "BASH_DEFAULT_TIMEOUT_MS":  "600000",
                "MAX_THINKING_TOKENS":  "32000",
                "DISABLE_TELEMETRY":  "1",
                "DISABLE_ERROR_REPORTING":  "1",
                "DISABLE_AUTOUPDATER":  "1",
                "DISABLE_NON_ESSENTIAL_MODEL_CALLS":  "1",
                "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC":  "1",
                "ANTHROPIC_MODEL":  "qwen3-coder-30b-q4",
                "ANTHROPIC_DEFAULT_OPUS_MODEL":  "qwen3-coder-30b-q4",
                "ANTHROPIC_DEFAULT_SONNET_MODEL":  "qwen3-coder-30b-q4",
                "ANTHROPIC_DEFAULT_HAIKU_MODEL":  "qwen3-coder-30b-q4",
                "ANTHROPIC_SMALL_FAST_MODEL":  "qwen3-coder-30b-q4"
            },
    "includeCoAuthoredBy":  false,
    "permissions":  {
                        "allow":  [
                                      "Bash(uv run:*)",
                                      "Bash(uv add:*)",
                                      "Bash(pip install:*)",
                                      "Bash(python -m pip install:*)",
                                      "Bash(npm install:*)",
                                      "Bash(winget install:*)",
                                      "Bash(brew install:*)",
                                      "Bash(cargo add:*)",
                                      "Bash(git status:*)",
                                      "Bash(git diff:*)",
                                      "Bash(git log:*)",
                                      "Bash(git add:*)",
                                      "Bash(git commit:*)",
                                      "Bash(cargo build:*)",
                                      "Bash(cargo test:*)",
                                      "Bash(cargo clippy:*)",
                                      "Bash(pytest:*)",
                                      "Bash(cmake:*)",
                                      "Bash(make test:*)"
                                  ],
                        "deny":  [
                                     "WebFetch",
                                     "WebSearch",
                                     "Bash(curl:*)",
                                     "Bash(wget:*)",
                                     "Read(./connectors/supabase/.env)"
                                 ],
                        "defaultMode":  "acceptEdits"
                    },
    "theme":  "dark",
    "hooks":  {
                  "SessionStart":  [
                                       {
                                           "hooks":  [
                                                         {
                                                             "command":  "node bin/session-journal.js start",
                                                             "type":  "command"
                                                         }
                                                     ]
                                       }
                                   ],
                  "SessionEnd":  [
                                     {
                                         "hooks":  [
                                                       {
                                                           "command":  "node bin/session-journal.js end",
                                                           "type":  "command"
                                                       }
                                                   ]
                                     }
                                 ],
                  "PreCompact":  [
                                     {
                                         "hooks":  [
                                                       {
                                                           "command":  "node bin/session-journal.js compact",
                                                           "type":  "command"
                                                       }
                                                   ]
                                     }
                                 ]
              },
    "model":  "qwen3-coder-30b-q4"
}
